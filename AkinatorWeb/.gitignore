# Dépendances
node_modules/

# Variables d'environnement (SENSIBLES - ne jamais committer)
backend/.env
.env

# Base de données SQLite
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
# Swap d'éditeur : un swap de .env contiendrait les secrets en clair
*.swp
*.swo

# Avatars envoyés par les utilisateurs : contenu d'exécution, pas du code.
# Le dossier doit exister pour que routes/avatar.js puisse y écrire.
frontend/avatars/*
!frontend/avatars/.gitkeep

# Build
dist/
build/
